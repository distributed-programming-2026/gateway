#!/usr/bin/env bash
set -euo pipefail

version="${1:-}"
version="${version#v}"
if [[ "$#" != 1 || ! "$version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
  echo "usage: mise run release -- v<major.minor.patch>" >&2
  exit 2
fi
tag="v${version}"

if [[ "$(git branch --show-current)" != main ]]; then
  echo "release must run from main" >&2
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "release requires a clean working tree" >&2
  exit 1
fi

git fetch origin main --tags
if [[ "$(git rev-parse HEAD)" != "$(git rev-parse refs/remotes/origin/main)" ]]; then
  echo "local main must match origin/main" >&2
  exit 1
fi
if git rev-parse --verify --quiet "refs/tags/$tag" >/dev/null; then
  echo "tag already exists: $tag" >&2
  exit 1
fi

mise run all
if [[ -n "$(git status --porcelain)" ]]; then
  echo "checks changed tracked files or created untracked files; commit them before releasing" >&2
  exit 1
fi

git tag -a "$tag" -m "Release $tag"
git push origin "refs/tags/$tag"
printf 'Published tag %s. Follow the release workflow in GitHub Actions.\n' "$tag"
